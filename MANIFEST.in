include README.md LICENSE.md CHANGELOG.md CONTRIBUTING.md SECURITY.md
include requirements.lock config.example.json
recursive-include src *.py *.json *.md
recursive-include tests *.py
recursive-include scripts *.py
recursive-include docs *.md *.json
recursive-include examples *.md *.json *.jpg *.png *.svg *.html *.glb
recursive-include .github *.yml
global-exclude *.pyc
prune artifacts
prune runs
